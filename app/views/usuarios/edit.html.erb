<div style="max-width: 500px; margin: 40px auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px; font-family: sans-serif;">
  <h2>Editar Rol de Usuario</h2>
  <p><strong>Email:</strong> <%= @usuario.email %></p>

  <%= form_with model: @usuario, local: true do |f| %>
    <div style="margin-bottom: 20px;">
      <%= f.label :role, "Seleccionar Rol:", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.select :role, Usuario.roles.keys.map { |r| [r.capitalize, r] }, {}, { style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" } %>
    </div>

    <div style="display: flex; gap: 10px;">
      <%= f.submit "Guardar Cambios", style: "background: #0d6efd; color: white; border: none; padding: 10px 16px; border-radius: 4px; font-weight: bold; cursor: pointer;" %>
      <%= link_to "Cancelar", usuarios_path, style: "background: #6c757d; color: white; padding: 10px 16px; text-decoration: none; border-radius: 4px; font-weight: bold;" %>
    </div>
  <% end %>
</div>