<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Serviteca" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Serviteca">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin: 0; font-family: system-ui, -apple-system, sans-serif;">
    <% if usuario_signed_in? %>
      <nav style="background: #1a1a1a; color: white; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
        
        <!-- LADO IZQUIERDO: Marca y Links -->
        <div style="display: flex; align-items: center; gap: 20px;">
          <strong><%= link_to "Serviteca", root_path, style: "color: white; text-decoration: none; font-size: 1.2rem; font-weight: bold;" %></strong>

          <%# Botón visible solo para Encargado o Admin %>
          <% if current_usuario.admin? %>
            <%= link_to "📊 Panel de Administración", admin_panel_path, style: "background: #0d6efd; color: white; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-weight: bold;" %>
          <% end %>
        </div>

        <!-- LADO DERECHO: Usuario y Logout -->
        <div style="display: flex; align-items: center; gap: 15px;">
          <span style="color: #ccc; font-size: 0.9rem;">
            <%= current_usuario.email %> 
            <strong style="color: #17a2b8;">(<%= current_usuario.role %>)</strong>
          </span>
          
          <%= button_to "Cerrar sesión", destroy_usuario_session_path, method: :delete, data: { turbo: false }, style: "background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 0.9rem;" %>
        </div>
      </nav>
    <% end %>

    <!-- Alertas Flash -->
    <% if notice %>
      <p style="color: #155724; padding: 12px 20px; background: #d4edda; border: 1px solid #c3e6cb; margin: 15px 20px; border-radius: 4px;"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p style="color: #721c24; padding: 12px 20px; background: #f8d7da; border: 1px solid #f5c6cb; margin: 15px 20px; border-radius: 4px;"><%= alert %></p>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>