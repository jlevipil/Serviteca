<div style="max-width: 600px; margin: 40px auto; font-family: sans-serif; background: #f8f9fa; padding: 30px; border-radius: 8px; border: 1px solid #ddd;">
  <h2 style="margin-top: 0; color: #333;">Editar Recurso</h2>

  <%= form_with model: @recurso, local: true do |f| %>
    
    <div style="margin-bottom: 15px;">
      <%= f.label :codigo, "Código:", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.text_field :codigo, required: true, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :nombre, "Nombre del Recurso:", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.text_field :nombre, required: true, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 15px;">
			<%= f.label :tipo, "Tipo:", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
			<%= f.select :tipo, Recurso::TIPOS.invert, {}, { style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" } %>
		</div>

    <div style="margin-bottom: 15px;">
      <%= f.label :cantidad, "Cantidad / Stock:", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.number_field :cantidad, required: true, min: 0, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :ubicacion, "Ubicación en Taller:", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.text_field :ubicacion, placeholder: "Ej. Caja 1 Estante 2", style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :observaciones, "Observaciones / Detalles:", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= f.text_area :observaciones, rows: 3, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 20px;">
    	<%= f.label :fecha_vencimiento, "Fecha de Vencimiento / Revisión (Opcional):", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
    	<%= f.date_field :fecha_vencimiento, style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" %>
    	<small style="color: #6c757d; display: block; margin-top: 4px;">Puedes dejar este campo en blanco si el recurso no vence.</small>
    </div>

    <div style="display: flex; gap: 10px;">
      <%= f.submit "Guardar Cambios", style: "background: #28a745; color: white; border: none; padding: 10px 18px; border-radius: 4px; cursor: pointer; font-weight: bold;" %>
      <%= link_to "Cancelar", recursos_path, style: "background: #6c757d; color: white; text-decoration: none; padding: 10px 18px; border-radius: 4px; font-weight: bold;" %>
    </div>

  <% end %>
</div>